# Copy to .env (locally) or add in your host's dashboard (e.g. Vercel → Settings → Environment Variables)
SITE_URL=https://thestickykind.com
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_AUTOMATIC_TAX=false

# One-time prices
PRICE_SHEET_012=price_xxx
